#include <stdio.h>

int main() {
    int mat[3][3];
    int i, j;

    // Preenchimento da matriz
    int valores[3][3] = {
        {5, 8, 12},
        {15, 20, 25},
        {30, 35, 40}
    };

    for (i = 0; i < 3; i++) {
        for (j = 0; j < 3; j++) {
            mat[i][j] = valores[i][j];
        }
    }

    // Exibição da matriz
    printf("Matriz 3x3:\n");

    for (i = 0; i < 3; i++) {
        for (j = 0; j < 3; j++) {
            printf("%d\t", mat[i][j]);
        }
        printf("\n");
    }

    return 0;
}












































































